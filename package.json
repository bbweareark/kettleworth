{
  "name": "kettleworth",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kettleworth/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @kettleworth/web test:e2e",
    "db:generate": "pnpm --filter @kettleworth/db generate",
    "db:migrate": "pnpm --filter @kettleworth/db migrate",
    "db:push": "pnpm --filter @kettleworth/db push",
    "db:seed": "pnpm --filter @kettleworth/db seed",
    "db:studio": "pnpm --filter @kettleworth/db studio"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "prettier": "^3.6.2"
  }
}
