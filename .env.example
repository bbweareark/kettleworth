# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://kettleworth:kettleworth@localhost:5434/kettleworth
REDIS_URL=redis://localhost:6380

# Auth (better-auth). Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional social providers. Leave blank to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Magic-link email delivery (Resend). Blank = links are logged to the server console in dev.
RESEND_API_KEY=
EMAIL_FROM=Kettleworth <hello@kettleworth.app>

# AI coach. Blank = deterministic coach (rules engine only, scripted intake).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Video (Mux). Blank = labelled placeholder previews.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# YouTube demos (official Data API v3). Run: pnpm --filter @kettleworth/db exec tsx scripts/find-youtube.ts
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ALLOWLIST=

# Wearable providers (OAuth). Blank = provider shows as "not configured".
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Field-level encryption for health data & OAuth tokens (32 bytes base64). openssl rand -base64 32
HEALTH_DATA_ENCRYPTION_KEY=

# Observability (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# Deployment
CRON_SECRET=            # Vercel Cron sends this as a bearer token to /api/cron/weekly
PHOTO_STORAGE=          # "db" stores body photos in Postgres (set on Vercel, whose disk is ephemeral); blank = local disk
